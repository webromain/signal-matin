# Signal Matin : génère le journal chaque matin à 7 h 30 sur un serveur Debian.
#
# Installation (le fichier installé ne doit pas avoir d'extension, cron l'ignorerait) :
#   1. adapter les deux lignes SIGNAL_MATIN_DIR et l'utilisateur ci-dessous ;
#   2. sudo install -o root -g root -m 644 deploy/signal-matin.cron /etc/cron.d/signal-matin
#
# Prérequis sur le serveur :
#   - Docker installé, et l'utilisateur ci-dessous membre du groupe docker
#       sudo usermod -aG docker <utilisateur>    (puis se reconnecter)
#   - l'image construite une première fois :  docker compose build
#   - config.yaml, credentials.json et token.json présents dans le dossier du projet
#   - .env avec TELEGRAM_BOT_TOKEN et TELEGRAM_CHAT_ID pour recevoir le PDF sur Telegram
#   - l'heure du serveur réglée sur Paris, car cron suit l'heure du système :
#       sudo timedatectl set-timezone Europe/Paris
#
# Vérifier après coup :  tail output/cron.log   et   ls output/pdf/

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Dossier où le dépôt est cloné sur le serveur.
SIGNAL_MATIN_DIR=/home/debian/signal-matin

# minute heure jour mois jour-semaine utilisateur commande
# -T : pas de terminal sous cron. UID/GID : les PDF appartiennent à l'utilisateur, pas à root.
30 7 * * * debian cd "$SIGNAL_MATIN_DIR" && UID=$(id -u) GID=$(id -g) docker compose run --rm -T signal-matin >> "$SIGNAL_MATIN_DIR/output/cron.log" 2>&1
